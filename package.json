{
	"name": "rsi-assist",
	"version": "1.3.1",
	"description": "Assistant de prévention des TMS pour la saisie répétitive",
	"license": "MIT",
	"scripts": {
		"start": "web-ext run",
		"start:firefox": "web-ext run",
		"start:chrome": "web-ext run --target=chromium",
		"build": "web-ext build --overwrite-dest",
		"build:firefox": "web-ext build --overwrite-dest",
		"build:chrome": "web-ext build --overwrite-dest --artifacts-dir web-ext-artifacts/chrome",
		"rebuild": "web-ext build --overwrite-dest",
		"sign": "web-ext sign --channel listed"
	},
	"dependencies": {
		"web-ext": "^10.8.0"
	}
}
